let mapleader = " "
set scrolloff=10
set incsearch
set hlsearch
set ignorecase
set smartcase
set clipboard+=unnamed
set clipboard+=ideaput      " paste through the IDE (fixes imports, like Ctrl+V)
set ideajoin                " J joins lines the smart way (strings, comments)
set idearefactormode=keep   " stay in Normal mode after rename/extract
set number
set relativenumber
set showmode
set visualbell

set which-key
set notimeout

set surround
set argtextobj
set easymotion
set textobj-entire
set highlightedyank
set NERDTree
set commentary
set exchange
set matchit

